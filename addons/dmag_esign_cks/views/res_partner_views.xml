<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_cks" model="ir.ui.view">
        <field name="name">res.partner.form.cks</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="dmag_cks_personal_id" invisible="is_company"/>
                <field name="dmag_cks_require"/>
            </xpath>
        </field>
    </record>
</odoo>
