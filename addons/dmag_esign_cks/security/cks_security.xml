<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cks" model="ir.module.category">
        <field name="name">Ký số</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_cks_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="category_id" ref="module_category_cks"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Tạo và gửi hồ sơ ký số, xem kết quả kiểm tra chữ ký.</field>
    </record>
    <record id="group_cks_manager" model="res.groups">
        <field name="name">Quản trị</field>
        <field name="category_id" ref="module_category_cks"/>
        <field name="implied_ids" eval="[(4, ref('group_cks_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Cấu hình nhà cung cấp chữ ký số, chứng thư của DMAG và Root CA tin cậy.</field>
    </record>
</odoo>
