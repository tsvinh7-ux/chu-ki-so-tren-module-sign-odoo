<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cks_send_wizard_form" model="ir.ui.view">
        <field name="name">dmag.cks.send.wizard.form</field>
        <field name="model">dmag.cks.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Gửi ký số">
                <group>
                    <field name="document_name"/>
                    <field name="partner_id"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="attachment_id" invisible="not res_model" options="{'no_create': True}"/>
                    <field name="pdf_file" filename="pdf_filename"/>
                    <field name="pdf_filename" invisible="1"/>
                    <field name="require_customer"/>
                    <field name="signer_kind" invisible="not require_customer"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Gửi ký số" class="btn-primary"/>
                    <button special="cancel" string="Hủy"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_cks_send_wizard" model="ir.actions.act_window">
        <field name="name">Gửi ký số</field>
        <field name="res_model">dmag.cks.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
