<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trang ký của module Sign: đưa cấu hình ký số cho hộp chọn chữ ký.
         Odoo Sign 17 dùng template "sign.doc_sign" với biến current_request_item;
         nếu bản của Bizapps khác, chỉ cần sửa inherit_id / xpath ở đây. -->
    <template id="sign_doc_cks_config" inherit_id="sign.doc_sign" name="Cấu hình ký số USB token">
        <xpath expr="//owl-component" position="before">
            <div id="dmag_cks_config" class="d-none" t-if="current_request_item"
                 t-att-data-config="current_request_item.sudo()._dmag_cks_frontend_config()"/>
        </xpath>
    </template>
</odoo>
