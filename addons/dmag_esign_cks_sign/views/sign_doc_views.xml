<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cks_sign_doc_tree" model="ir.ui.view">
        <field name="name">dmag.cks.sign.doc.tree</field>
        <field name="model">dmag.cks.sign.doc</field>
        <field name="arch" type="xml">
            <tree create="0" decoration-success="state == 'done' and verify_ok" decoration-warning="state == 'signing'">
                <field name="reference"/>
                <field name="summary"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'signing'"/>
                <field name="verify_ok"/>
                <field name="write_date" string="Cập nhật"/>
            </tree>
        </field>
    </record>
    <record id="view_cks_sign_doc_form" model="ir.ui.view">
        <field name="name">dmag.cks.sign.doc.form</field>
        <field name="model">dmag.cks.sign.doc</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_open_request" type="object" string="Mở yêu cầu ký" class="btn-primary"/>
                    <button name="action_verify" type="object" string="Kiểm tra chữ ký"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="reference"/></h1></div>
                    <group>
                        <group>
                            <field name="summary"/>
                            <field name="verify_ok"/>
                        </group>
                        <group>
                            <field name="current_pdf" filename="reference" string="Bản PDF hiện tại"/>
                            <field name="res_model" invisible="1"/>
                        </group>
                    </group>
                    <field name="verify_html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cks_sign_doc" model="ir.actions.act_window">
        <field name="name">Tài liệu ký số trong Sign</field>
        <field name="res_model">dmag.cks.sign.doc</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_cks_sign_doc" name="Tài liệu ký trong Sign" parent="dmag_esign_cks.menu_cks_root"
              sequence="15" action="action_cks_sign_doc"/>
</odoo>
